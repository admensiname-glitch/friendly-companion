{
  "appId": "com.ensiname.app",
  "appName": "Ensina-me",
  "webDir": "www",
  "loggingBehavior": "none",
  "backgroundColor": "#101010",
  "android": {
    "minWebViewVersion": 60,
    "initialFocus": true
  },
  "server": {
    "url": "https://ensina-me-sigma.vercel.app",
    "cleartext": false,
    "androidScheme": "https",
    "errorPath": "offline.html"
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css",
      "style": "DARK",
      "hidden": false,
      "animation": "NONE",
      "initialViewportFitValueHint": "cover"
    }
  }
}
