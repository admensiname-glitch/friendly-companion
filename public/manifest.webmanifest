{
  "id": "/app",
  "name": "Ensina-me",
  "short_name": "Ensina-me",
  "description": "Estude, pratique, revise e acompanhe seu aprendizado em um só lugar.",
  "lang": "pt-BR",
  "start_url": "/app/dashboard",
  "scope": "/",
  "display": "fullscreen",
  "display_override": [
    "fullscreen",
    "standalone"
  ],
  "orientation": "portrait",
  "background_color": "#101010",
  "theme_color": "#101010",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/ensina-me-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ]
}
